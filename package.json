  "description": "Production-grade Luxury E-Commerce Platform with Express REST API, SQLite, Razorpay Checkout, and React/Tailwind frontend.",
  "type": "module",
  "scripts": {
    "postinstall": "cd client && npm install",
    "build": "cd client && npm run build",
    "start": "node server/src/index.js",
    "seed": "cd server && npm run seed"
  },
  "dependencies": {
